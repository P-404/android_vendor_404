android_app_import {
    name: "Gramophone",

    certificate: "platform",
    dex_preopt: {
        enabled: false,
    },
    overrides: ["SnapdragonMusic"],

    compile_multilib: "both",
    apk: "app/Gramophone.apk",

}

android_app_import {
    name: "404Clock",

    overrides: ["DeskClock"],
    certificate: "platform",
    dex_preopt: {
        enabled: false,
    },

    compile_multilib: "both",
    apk: "app/404Clock.apk",

}

android_app_import {
    name: "GrapheneCam",
    product_specific: true,

    certificate: "platform",
    dex_preopt: {
        enabled: false,
    },
    compile_multilib: "both",

    apk: "app/GrapheneCam.apk",
    overrides: ["Camera", "Camera2"],
}
